  "dependencies": {
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.81.5",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "express": "^4.22.2",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
