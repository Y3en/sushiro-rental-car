# Copy to config/config.env and fill in real values (config/config.env is git-ignored)
NODE_ENV=development
PORT=5000

MONGO_URI=mongodb://localhost:27017/sushiro-rental-car

JWT_SECRET=change-me
JWT_EXPIRE=30d
JWT_COOKIE_EXPIRE=30

# Used only by `npm run seed` to create the admin account
ADMIN_NAME=Admin
ADMIN_TEL=0800000000
ADMIN_EMAIL=admin@sushiro.com
ADMIN_PASSWORD=change-me
