# Copy to config/config.env and fill in real values (config/config.env is git-ignored)
NODE_ENV=development
PORT=5000

MONGO_URI=mongodb://127.0.0.1:27019/sushiro-rental-car?replicaSet=rs0&directConnection=true

JWT_SECRET=change-me
JWT_EXPIRE=30d
JWT_COOKIE_EXPIRE=30

# Used only by `npm run seed` to create the admin account
ADMIN_NAME=Admin
ADMIN_TEL=0800000000
ADMIN_EMAIL=admin@sushiro.com
ADMIN_PASSWORD=change-me

# Run the worker separately: npm run worker
REDIS_URL=redis://127.0.0.1:6381
# log never sends externally; live enables SendGrid/Twilio
NOTIFICATION_MODE=log
NOTIFICATION_CHANNELS=email
SENDGRID_API_KEY=
EMAIL_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
SMS_FROM=
