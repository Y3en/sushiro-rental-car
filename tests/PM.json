{
  "info": {
    "name": "Booking API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {"key": "baseUrl", "value": "http://localhost:5000/api/v1"},
    {"key": "token", "value": ""},
    {"key": "providerId", "value": ""},
    {"key": "bookingId", "value": ""}
  ],
  "item": [
    {
      "name": "Create booking (#4)",
      "request": {
        "method": "POST",
        "header": [{"key": "Authorization", "value": "Bearer {{token}}"}, {"key": "Content-Type", "value": "application/json"}],
        "body": {"mode": "raw", "raw": "{\"provider\":\"{{providerId}}\",\"pickupDate\":\"2026-12-01T10:00:00.000Z\"}"},
        "url": "{{baseUrl}}/bookings"
      }
    },
    {"name": "Get own bookings (#5)", "request": {"method": "GET", "header": [{"key": "Authorization", "value": "Bearer {{token}}"}], "url": "{{baseUrl}}/bookings"}},
    {"name": "Get own booking (#5)", "request": {"method": "GET", "header": [{"key": "Authorization", "value": "Bearer {{token}}"}], "url": "{{baseUrl}}/bookings/{{bookingId}}"}},
    {"name": "Update own booking (#5)", "request": {"method": "PUT", "header": [{"key": "Authorization", "value": "Bearer {{token}}"}, {"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\"pickupDate\":\"2026-12-02T10:00:00.000Z\",\"provider\":\"{{providerId}}\"}"}, "url": "{{baseUrl}}/bookings/{{bookingId}}"}},
    {"name": "Delete own booking (#5)", "request": {"method": "DELETE", "header": [{"key": "Authorization", "value": "Bearer {{token}}"}], "url": "{{baseUrl}}/bookings/{{bookingId}}"}}
  ]
}
